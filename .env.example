# Gemini / Google AI Studio (Opcional - Substitui OpenAI se preenchido)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MONTHLY_BUDGET_USD=50

# Chrome CDP
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=C:\ChromeProfiles\InstagramAutomation

# Instagram API (Meta)
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_PAGE_ACCESS_TOKEN=your-page-access-token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-verify-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-business-id

# Database
DATABASE_URL=./data/prospector.db

# Rate Limits
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240

# Operating Schedule
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo
