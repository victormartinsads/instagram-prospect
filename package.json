{
  "name": "prospect-instagram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n \"web,worker\" -c \"blue,green\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "build": "next build",
    "start": "next start",
    "start:worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.0",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "openai": "^4.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
